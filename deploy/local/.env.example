# Copy to .env next to docker-compose.yml and edit. Everything is optional.

# --- Updates ---------------------------------------------------------------------
# Which version to run. The container pulls it on every start.
SPARK_REF=main                  # a branch (main), a release tag (v0.1.0-rc1) or a commit to stay on
# SPARK_REPO_URL=https://github.com/TheCodeheadMT/SPARK_DOCKER.git
# Only for a private fork: a GitHub fine-grained token with read-only "Contents" access.
# GIT_TOKEN=

# --- App -------------------------------------------------------------------------
SPARK_PORT=8000                 # open http://localhost:<this port>
ENABLE_FIXTURES=false           # true = add two synthetic demo courses (made-up students)
UPLOADS_ENABLED=true
UPLOAD_MAX_MB=200
BB_TOTAL_COLUMN=Final Grade
BB_LETTER_COLUMN=Overall Grade
LATE_GRACE_MINUTES=0

# --- Extra Instruction (AI generation, optional) -----------------------------------
LLM_PROVIDER=none               # none | openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=              # blank = OpenAI; set for Azure OpenAI or an institutional gateway
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_RATE_PER_HOUR=30
