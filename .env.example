# Copy to .env (or export) before starting the API. All values shown are the defaults.
ENV=development                 # development | test | production
AUTH_MODE=local                 # local: no sign-in, choose Instructor or Admin mode | simulated: test personas | entra: Phase 6.
                                # local and simulated are refused when ENV=production
SECRET_KEY=dev-only-change-me   # REQUIRED in production: signs the session cookie

DATA_DIR=./var                  # course DuckDB files, metadata DB, snapshots (local disk, NOT the WebDAV mount)
# DATABASE_URL=postgresql+psycopg://spark:...@db/spark   # default: sqlite in DATA_DIR

BB_ROOT=./dev_share             # optional WebDAV mount point (empty = uploads only); SPARK reads BB_ROOT/SPARK/<course>/...  (prod: /mnt/bb)
BB_TOTAL_COLUMN=Final Grade     # gradebook calculated column used as the current grade
BB_LETTER_COLUMN=Overall Grade
LATE_GRACE_MINUTES=0

UPLOADS_ENABLED=true            # instructors can upload gradebook exports to SPARK (no WebDAV needed)
UPLOAD_MAX_MB=200               # per file, all uploads. Behind nginx also set client_max_body_size (e.g. 410m for 2 files)

# Blackboard mount watching (see deploy/webdav/README.md)
BB_POLL_INTERVAL_S=0            # 0 = off. Server: 300 (check for new exports every 5 min)
BB_SETTLE_S=120                 # ingest an export once it has been unchanged this long
BB_IO_TIMEOUT_S=20              # give up on a hung WebDAV call after this long
BB_REQUIRE_MOUNT=false          # server: true (an unmounted BB_ROOT/SPARK is an error, not "no courses")

ENABLE_FIXTURES=true            # synthetic demo courses (no real students)

# Canvas (optional, kept from the original SPARK)
# CANVAS_BASE_URL=https://canvas.instructure.com
# CANVAS_API_TOKEN=

# Extra Instruction (EI) | AI generation. The key stays on the server.
LLM_PROVIDER=none               # none | openai | fake (fake = canned text for demos/tests, refused in production)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=              # blank = OpenAI; set for Azure OpenAI or an institutional gateway
LLM_MODELS=gpt-5.2,gpt-5.1,gpt-4o,gpt-4o-mini
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_RATE_PER_HOUR=30            # per user; 0 = unlimited
